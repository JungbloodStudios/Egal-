<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jungblood Studios | LEGO Star Wars MOCs</title>
    <style>
        :root {
            --bg-color: #0c0f17;
            --card-bg: #141a26;
            --accent: #f1c40f;
            --accent-hover: #f39c12;
            --text-main: #f8f9fa;
            --text-muted: #a0aec0;
            --border: #2d3748;
            --glow: rgba(241, 196, 15, 0.25);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Roboto, sans-serif; }
        body { background-color: var(--bg-color); color: var(--text-main); line-height: 1.6; }

        header {
            background: linear-gradient(135deg, #141a26 0%, #0c0f17 100%);
            border-bottom: 2px solid var(--border);
            padding: 2rem 1rem; text-align: center; position: sticky; top: 0; z-index: 100;
        }

        .logo-area h1 { font-size: 2.4rem; letter-spacing: 2px; text-transform: uppercase; }
        .logo-area h1 span { color: var(--accent); text-shadow: 0 0 12px var(--glow); }
        .logo-area p { color: var(--text-muted); font-size: 1.05rem; margin-top: 0.4rem; }

        nav { margin-top: 1.5rem; display: flex; justify-content: center; gap: 1.5rem; flex-wrap: wrap; }
        nav a { color: var(--text-main); text-decoration: none; font-weight: 600; }
        nav a:hover { color: var(--accent); }

        .container { max-width: 1200px; margin: 0 auto; padding: 2.5rem 1rem; }
        section { margin-bottom: 4rem; }
        h2 { font-size: 2rem; margin-bottom: 1.5rem; border-left: 4px solid var(--accent); padding-left: 0.75rem; }

        .hero {
            text-align: center; padding: 3.5rem 1.5rem;
            background: radial-gradient(circle at center, #1e293b 0%, var(--bg-color) 75%);
            border-radius: 16px; border: 1px solid var(--border); margin-bottom: 2.5rem;
        }

        .btn {
            display: inline-flex; align-items: center; gap: 10px;
            background-color: var(--accent); color: #0c0f17; padding: 0.85rem 2rem;
            border-radius: 8px; text-decoration: none; font-weight: bold; margin: 0.5rem;
        }
        .btn-secondary { background-color: transparent; border: 2px solid var(--accent); color: var(--accent); }

        .grid-gallery {
            display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem;
        }

        .card {
            background-color: var(--card-bg); border: 1px solid var(--border);
            border-radius: 12px; padding: 1.2rem; transition: transform 0.2s;
        }
        .card:hover { border-color: var(--accent); transform: translateY(-3px); }
        .card img { width: 100%; height: auto; border-radius: 8px; margin-bottom: 1rem; border: 1px solid var(--border); }
        .card h3 { font-size: 1.2rem; margin-bottom: 0.5rem; }

        .video-container { position: relative; width: 100%; padding-bottom: 56.25%; height: 0; border-radius: 12px; overflow: hidden; }
        .video-container iframe { position: absolute; top:0; left:0; width:100%; height:100%; border:0; }

        .sub-counter {
            position: fixed; bottom: 25px; right: 25px;
            background-color: rgba(20, 26, 38, 0.95); border: 1px solid var(--accent);
            padding: 12px 18px; border-radius: 40px; display: flex; align-items: center; gap: 12px;
            z-index: 1000; font-weight: 600;
        }
        .pulse-dot { width: 12px; height: 12px; background-color: #ff4757; border-radius: 50%; animation: slowPulse 2.5s infinite; }
        @keyframes slowPulse {
            0% { transform: scale(0.95); opacity: 1; }
            70% { transform: scale(1); opacity: 0.8; box-shadow: 0 0 0 10px rgba(255, 71, 87, 0); }
            100% { transform: scale(0.95); opacity: 1; }
        }

        .paypal-box { background-color: var(--card-bg); border: 1px solid var(--border); border-radius: 12px; padding: 2rem; text-align: center; max-width: 500px; margin: 0 auto; }
        .paypal-box img { width: 200px; margin: 1rem auto; display: block; border-radius: 8px; }

        footer { text-align: center; padding: 2rem; border-top: 1px solid var(--border); color: var(--text-muted); }
    </style>
</head>
<body>

    <div class="sub-counter">
